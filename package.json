{
  "name": "stann-lumo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars ./node_modules/next/dist/bin/next dev --port 3004",
    "prebuild": "node scripts/check-token-sync.mjs",
    "build": "NEXT_DIST_DIR=$(node scripts/resolve-build-dist-dir.mjs) NODE_ENV=production next build && next typegen",
    "build:cloudflare": "node scripts/check-token-sync.mjs && npm run env:check:opennext && NEXT_DIST_DIR=.next opennextjs-cloudflare build && npm run env:check:opennext-artifact",
    "start": "NEXT_DIST_DIR=.next-build node --env-file-if-exists=.dev.vars ./node_modules/next/dist/bin/next start --port 3004",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:env": "node --test scripts/check-opennext-env.test.mjs",
    "test:local-config": "node --test scripts/check-local-server-config.test.mjs scripts/migrate-local-server-env.test.mjs scripts/resolve-build-dist-dir.test.mjs scripts/check-lockfile.test.mjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "env:check:opennext": "node scripts/check-opennext-env.mjs source",
    "env:check:opennext-artifact": "node scripts/check-opennext-env.mjs artifact",
    "migrate:local-env": "node scripts/migrate-local-server-env.mjs",
    "deploy": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "^15.0.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-i18next": "^15.6.0",
    "split-type": "^0.3.4",
    "three": "^0.183.2"
  },
  "optionalDependencies": {
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@dotenvx/dotenvx": "1.31.0",
    "@eslint/js": "^9.30.1",
    "@opennextjs/cloudflare": "^1.17.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.74.0"
  }
}

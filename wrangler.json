{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stann-lumo",
  "routes": [
    {
      "pattern": "lumo.stann.kr",
      "custom_domain": true
    }
  ],
  "main": "worker.ts",
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stann-lumo-db",
      "database_id": "9ef2f5b5-e0f2-4bb0-98e2-b3b1ba39917e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "stann-lumo-media"
    }
  ],
  "triggers": {
    "crons": ["15 19 * * SUN"]
  },
  "vars": {},
  "env": {
    "dev": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stann-lumo-db-dev",
          "database_id": "dfa422fd-796f-4cdc-a054-8bb97b49d035"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "stann-lumo-media-dev"
        }
      ],
      "triggers": {
        "crons": []
      },
      "vars": {
        "MIGRATE_ENABLED": "false",
        "NEXTJS_ENV": "development"
      }
    }
  }
}
